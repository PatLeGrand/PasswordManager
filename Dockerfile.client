# Build context : racine du projet (pour accéder à server/src/lib/api.ts)
FROM node:20-alpine AS builder
WORKDIR /app

# Copie les dépendances client
COPY client/package*.json ./client/
RUN cd client && npm ci

# Copie le fichier partagé (importé par le client)
COPY server/src/lib/api.ts ./server/src/lib/api.ts

# Copie le reste du client et build
COPY client/ ./client/
RUN cd client && npm run build

# ── Nginx pour servir les fichiers statiques ──
FROM nginx:alpine
COPY --from=builder /app/client/dist /usr/share/nginx/html
COPY nginx/prod.conf /etc/nginx/conf.d/default.conf
EXPOSE 80 443
