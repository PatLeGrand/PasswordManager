# Copier ce fichier en .env et remplir les valeurs

# Base de données
DB_ROOT_PASSWORD=change_me_strong_password

# JWT (générer avec : openssl rand -hex 64)
JWT_SECRET=change_me_very_long_random_secret

# Email (Ethereal pour les tests, SMTP réel pour la prod)
EMAIL_USER=your@email.com
EMAIL_PASS=your_email_password

# Domaine (sans https://)
DOMAIN=ton-domaine.com
